#
# Multi-school puavo-flavoured test data for the local LDAP.
#
# Structure:
#   ou=Puavo,dc=planetexpress,dc=com
#     ou=Schools          — two schools (Alpha School, Beta School)
#     ou=People           — five users with varying affiliations + schools
#     ou=Groups           — four class groups across the two schools
#
# Login passwords match the uid for every user (alice/alice, etc.).
#
# Coverage:
#   - alice:   teacher in Alpha only
#   - bob:     teacher in BOTH Alpha and Beta (multi-school)
#   - charlie: teacher in Beta only
#   - diana:   student in Alpha
#   - erik:    student in Beta
#
#   - alpha-1a:    year class @ Alpha, members: diana
#   - alpha-2a:    year class @ Alpha, no members
#   - beta-1a:     year class @ Beta, members: erik
#   - beta-math:   teaching group @ Beta, members: erik
#
# Expected app behaviour after sync:
#   teachers table: 4 rows = (alice, Alpha) (bob, Alpha) (bob, Beta) (charlie, Beta)
#   groups table:   4 rows
#   alice  → can share to alpha-*, NOT to beta-*
#   bob    → can share to all four
#   charlie → can share to beta-*, NOT to alpha-*
#   diana / erik → cannot share to any (not teachers)

# ---- top-level OUs ----

dn: ou=Puavo,dc=planetexpress,dc=com
objectClass: organizationalUnit
ou: Puavo

dn: ou=Schools,ou=Puavo,dc=planetexpress,dc=com
objectClass: organizationalUnit
ou: Schools

dn: ou=People,ou=Puavo,dc=planetexpress,dc=com
objectClass: organizationalUnit
ou: People

dn: ou=Groups,ou=Puavo,dc=planetexpress,dc=com
objectClass: organizationalUnit
ou: Groups

# ---- schools ----

dn: puavoId=200001,ou=Schools,ou=Puavo,dc=planetexpress,dc=com
objectClass: top
objectClass: organizationalUnit
objectClass: puavoEduGroup
objectClass: extensibleObject
ou: alpha
displayName: Alpha School
puavoId: 200001

dn: puavoId=200002,ou=Schools,ou=Puavo,dc=planetexpress,dc=com
objectClass: top
objectClass: organizationalUnit
objectClass: puavoEduGroup
objectClass: extensibleObject
ou: beta
displayName: Beta School
puavoId: 200002

